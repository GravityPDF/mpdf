# Don't include these files and directories when exporting archives
*.gitattributes export-ignore
/utils export-ignore
/tests export-ignore
/packages export-ignore

# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.php text
*.txt text
*.css text
*.ini text
*.htm text

# Golden master fixtures are compared with the bytes the code produces, which uses "\n"
# whatever the platform. A CRLF checkout would fail that comparison on Windows without
# anything about the parser or the font having changed.
tests/data/fontcache/*.json text eol=lf
tests/data/otldump/*.txt text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.pdf binary
